# --- Server ---
PORT=8787
# Required to open /inbox. Without it the admin API stays disabled.
ADMIN_TOKEN=
# Optional. Each new order or enquiry is POSTed here as JSON (Slack, Make, Zapier, CRM...).
NOTIFY_WEBHOOK_URL=
# Optional. Where the SQLite file lives. Defaults to ./data/ghalia.db
DATABASE_PATH=

# --- Public contact details (shown on the site only when set) ---
VITE_CONTACT_PHONE=
VITE_CONTACT_EMAIL=
# Social accounts live in src/content/site.js (`social`).

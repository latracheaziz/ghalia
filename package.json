  "description": "GHALIA — Luxury Chocolate Maison, Weddings & Events.",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev": "concurrently -n web,api -c yellow,cyan \"vite\" \"node --watch --disable-warning=ExperimentalWarning server/index.js\"",
    "build": "vite build",
    "start": "node --disable-warning=ExperimentalWarning server/index.js",
    "preview": "npm run build && npm start",
    "media": "node scripts/prepare-media.mjs",
    "test": "node --disable-warning=ExperimentalWarning --test server/api.test.js src/three/configurator/boxes.test.js",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource/amiri": "^5.3.0",
    "@fontsource/cormorant": "^5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "@fontsource/jost": "^5.3.0",
    "@fontsource/mrs-saint-delafield": "^5.3.0",
    "@gsap/react": "^2.1.2",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "express": "^5.3.0",
    "gsap": "^3.15.0",
    "lenis": "^1.3.27",
    "lucide-react": "^1.67.0",
    "motion": "^14.9.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
